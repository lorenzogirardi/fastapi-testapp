{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Traffic",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(traefik_entrypoint_requests_total{job=\"traefik\"}[2m])) by (entrypoint, code)",
          "legendFormat": "{{entrypoint}} {{code}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate by Entrypoint & Code",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(traefik_entrypoint_request_duration_seconds_bucket{job=\"traefik\"}[2m])) by (le, entrypoint))",
          "legendFormat": "p50 {{entrypoint}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(traefik_entrypoint_request_duration_seconds_bucket{job=\"traefik\"}[2m])) by (le, entrypoint))",
          "legendFormat": "p95 {{entrypoint}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(traefik_entrypoint_request_duration_seconds_bucket{job=\"traefik\"}[2m])) by (le, entrypoint))",
          "legendFormat": "p99 {{entrypoint}}",
          "refId": "C"
        }
      ],
      "title": "Latency p50/p95/p99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 3,
      "targets": [
        {
          "expr": "traefik_open_connections{job=\"traefik\"}",
          "legendFormat": "{{entrypoint}} {{protocol}}",
          "refId": "A"
        }
      ],
      "title": "Open Connections",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "Bps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(traefik_entrypoint_requests_bytes_total{job=\"traefik\"}[2m])) by (entrypoint)",
          "legendFormat": "rx {{entrypoint}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(traefik_entrypoint_responses_bytes_total{job=\"traefik\"}[2m])) by (entrypoint)",
          "legendFormat": "tx {{entrypoint}}",
          "refId": "B"
        }
      ],
      "title": "Bandwidth In/Out",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 101,
      "title": "TLS & Config",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(traefik_entrypoint_requests_tls_total{job=\"traefik\"}[2m])) by (entrypoint, tls_version)",
          "legendFormat": "{{entrypoint}} {{tls_version}}",
          "refId": "A"
        }
      ],
      "title": "TLS Requests by Version",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 6,
      "targets": [
        {
          "expr": "traefik_config_reloads_total{job=\"traefik\"}",
          "legendFormat": "total reloads",
          "refId": "A"
        },
        {
          "expr": "traefik_config_last_reload_success{job=\"traefik\"}",
          "legendFormat": "last reload success",
          "refId": "B"
        }
      ],
      "title": "Config Reloads",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 102,
      "title": "Stats",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 27 },
      "id": 10,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(rate(traefik_entrypoint_requests_total{job=\"traefik\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "Total RPS (5m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 27 },
      "id": 11,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(traefik_entrypoint_request_duration_seconds_bucket{job=\"traefik\"}[5m])) by (le))",
          "refId": "A"
        }
      ],
      "title": "p95 Latency (5m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 27 },
      "id": 12,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(traefik_open_connections{job=\"traefik\"})",
          "refId": "A"
        }
      ],
      "title": "Open Connections",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "fixedColor": "red", "mode": "fixed" } } },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 27 },
      "id": 13,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(rate(traefik_entrypoint_requests_total{job=\"traefik\", code=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "5xx Rate",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "tags": ["traefik", "ingress"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource",
        "label": "Datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Traefik — Ingress",
  "uid": "traefik-ingress",
  "version": 1
}
